{
  "name": "@robodog/server",
  "version": "0.1.0",
  "private": true,
  "description": "RoboDog backend: REST + WebSocket API, SQLite storage, media store and simulation mode",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.2",
    "@fastify/websocket": "^11.0.1",
    "@robodog/shared": "0.1.0",
    "better-sqlite3": "^11.5.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "jpeg-js": "^0.4.4",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
