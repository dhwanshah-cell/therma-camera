# RoboDog server configuration. Copy to server/.env (git-ignored) or export in your shell.
# None of these values are secrets by themselves; ROBODOG_API_TOKEN MUST be changed for real deployments.

# TCP port and bind address
ROBODOG_PORT=8080
ROBODOG_HOST=0.0.0.0

# Shared API token expected in the `x-robodog-token` header, `Authorization: Bearer ...`
# or the `?token=` query parameter (WebSocket / <img src>). The development default is
# `robodog-dev-token` (DEV_API_TOKEN in @robodog/shared) and the server warns when it is used.
ROBODOG_API_TOKEN=change-me-before-deploying

# SQLite database file (WAL mode). Parent directories are created automatically.
ROBODOG_DB_PATH=./data/robodog.db

# Root directory for uploaded media. Served (token-protected) under /media/.
ROBODOG_MEDIA_DIR=./media

# Simulation mode: 'true' or '1' enables clearly labelled synthetic data (source: SIMULATION).
ROBODOG_SIMULATION=false

# CORS origin for the web dashboard. '*' for development.
ROBODOG_CORS_ORIGIN=*

# pino log level: trace | debug | info | warn | error | fatal | silent
ROBODOG_LOG_LEVEL=info
