# Base URL of the RoboDog server REST API. Leave empty to use the same origin
# (the Vite dev server proxies /api, /ws and /media to http://localhost:8080).
VITE_API_BASE=

# WebSocket URL. Leave empty to derive it from the page location (ws(s)://<host>/ws).
VITE_WS_URL=

# Shared API token. Defaults to the development token from @robodog/shared (DEV_API_TOKEN).
# Can be overridden at runtime on the SETTINGS page (stored in localStorage).
VITE_API_TOKEN=robodog-dev-token
